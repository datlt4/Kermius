{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kermius",
  "version": "1.38.9",
  "identifier": "com.koi.kermius",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kermius",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#14161d",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "rsync",
          "mosh"
        ],
        "recommends": [
          "inotify-tools"
        ]
      },
      "rpm": {
        "depends": [
          "rsync",
          "mosh"
        ],
        "recommends": [
          "inotify-tools"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENDI0RTdCNTNFQUU0QkQKUldTOTVPcFRlMDVDL1lOcC9CamhLMXB5NWlGbnU1SFVtQ2V5OTVHUnRqZGF3TXB6WjVaU1U3SXIK",
      "endpoints": [
        "https://github.com/datlt4/Kermius/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
